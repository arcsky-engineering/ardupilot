# hw definition file for processing by chibios_hwdef.py

# MCU class and specific type
MCU STM32H7xx STM32H743xx

include hwdef.inc

# build ABIN for flash-from-bootloader support:
env BUILD_ABIN True

# Arcsky X55 branding: what the host OS shows for the USB device
undef USB_STRING_MANUFACTURER
undef USB_STRING_PRODUCT
USB_STRING_MANUFACTURER "Arcsky"
USB_STRING_PRODUCT "X55"

# Arcsky X55 firmware version string (AP_CUSTOM_FIRMWARE_STRING)
include ../include/x55_version.inc
